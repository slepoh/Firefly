---
import { getCollection, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 已有独立路由的内置 spec 页面（about/friends/guestbook），不要在此重复生成，避免重复 URL
const BUILTIN_SPEC_PAGES = ["about", "friends", "guestbook"];

export const getStaticPaths = async () => {
	const entries = await getCollection("spec");
	return entries
		.filter((entry) => !BUILTIN_SPEC_PAGES.includes(entry.id))
		.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = entry.id;
---

<MainGridLayout title={title} description={title}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full ">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
